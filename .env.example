# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Supabase – use the SERVICE_ROLE key (not anon!)
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Admin token for internal endpoints (doctor, idempotency checks)
VN_ADMIN_TOKEN=

# n8n connection (if not using per-connection DB config)
N8N_BASE_URL=
N8N_API_KEY=

# Server
PORT=3000
NODE_LIBRARY_DEBUG=1
